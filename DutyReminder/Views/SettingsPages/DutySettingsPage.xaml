<ci:SettingsPageBase x:Class="ClassIsland.DutyReminder.Views.SettingsPages.DutySettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassIsland.DutyReminder.Views.SettingsPages"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      mc:Ignorable="d"
      Title="值日提醒"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      Background="{DynamicResource MaterialDesignPaper}"
      FontFamily="{StaticResource HarmonyOsSans}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="14"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：规则列表 -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="提醒规则" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>
            <ListBox x:Name="RulesList" Height="300" SelectionChanged="RulesList_OnSelectionChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                <Button Content="删除选中" Padding="14 6" Margin="0 0 8 0" Click="ButtonDelete_OnClick"/>
                <Button Content="保存全部" Padding="14 6" Click="ButtonSave_OnClick"/>
            </StackPanel>
            <TextBlock Text="提示：保存后的规则立即生效，无需重启。" FontSize="12" Foreground="#888888" Margin="0 10 0 0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 右侧：编辑表单 -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="添加 / 修改规则" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>

            <!-- 触发方式二选一：每节上课前 / 自定义时间 -->
            <TextBlock Text="触发方式" Margin="0 4 0 2"/>
            <ComboBox x:Name="TriggerCombo" SelectedIndex="0" SelectionChanged="TriggerCombo_OnSelectionChanged">
                <ComboBoxItem Content="每节上课前"/>
                <ComboBoxItem Content="自定义时间（每天）"/>
            </ComboBox>

            <StackPanel x:Name="LeadPanel">
                <TextBlock Text="提前分钟数（距上课还有 X 分钟时提醒）" Margin="0 10 0 2"/>
                <TextBox x:Name="LeadBox" Text="2"/>
            </StackPanel>

            <StackPanel x:Name="TimePanel" Visibility="Collapsed">
                <TextBlock Text="触发时间（每天固定时刻，HH:mm）" Margin="0 10 0 2"/>
                <TextBox x:Name="TimeBox" Text="07:40"/>
            </StackPanel>

            <TextBlock Text="预设内容（选择后可继续编辑）" Margin="0 10 0 2"/>
            <ComboBox x:Name="PresetCombo" SelectionChanged="PresetCombo_OnSelectionChanged">
                <ComboBoxItem Content="请值日生擦黑板"/>
                <ComboBoxItem Content="请值日生整理讲台"/>
                <ComboBoxItem Content="请值日生倒垃圾"/>
                <ComboBoxItem Content="请值日生关灯、关窗"/>
                <ComboBoxItem Content="请值日生擦黑板并整理讲台"/>
                <ComboBoxItem Content="请值日生准备上课，擦净黑板"/>
            </ComboBox>

            <TextBlock Text="提醒内容" Margin="0 10 0 2"/>
            <TextBox x:Name="TextBlockBox" Text="请值日生擦黑板" AcceptsReturn="False"/>

            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                <CheckBox x:Name="SpeechCheck" Content="语音播报" IsChecked="True" Margin="0 0 16 0"/>
                <CheckBox x:Name="EnabledCheck" Content="启用" IsChecked="True"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 14 0 0">
                <Button Content="添加规则" Padding="14 6" Margin="0 0 8 0" Click="ButtonAdd_OnClick"/>
                <Button Content="更新选中" Padding="14 6" Margin="0 0 8 0" Click="ButtonUpdate_OnClick"/>
                <Button Content="测试触发提醒" Padding="14 6" Click="ButtonTest_OnClick"/>
            </StackPanel>
            <TextBlock Text="「测试触发提醒」会立即按上方内容弹出一次提醒并试听语音，不写入规则。"
                       FontSize="12" Foreground="#888888" Margin="0 10 0 0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</ci:SettingsPageBase>
