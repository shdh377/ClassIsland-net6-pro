<ci:SettingsPageBase x:Class="ClassIsland.WebOpener.Views.SettingsPages.WebOpenerSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassIsland.WebOpener.Views.SettingsPages"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      mc:Ignorable="d"
      Title="定时打开网页"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      Background="{DynamicResource MaterialDesignPaper}"
      FontFamily="{StaticResource HarmonyOsSans}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="14"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：规则列表 -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="打开计划" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>
            <ListBox x:Name="RulesList" Height="300" SelectionChanged="RulesList_OnSelectionChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                <Button Content="删除选中" Padding="14 6" Margin="0 0 8 0" Click="ButtonDelete_OnClick"/>
                <Button Content="保存全部" Padding="14 6" Click="ButtonSave_OnClick"/>
            </StackPanel>
            <TextBlock Text="提示：打开前 1 分钟会弹出确认对话框，点击「暂不打开」可取消本次计划；保存后立即生效，无需重启。"
                       FontSize="12" Foreground="#888888" Margin="0 10 0 0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 右侧：编辑表单 -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="添加 / 修改计划" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>

            <TextBlock Text="触发方式" Margin="0 4 0 2"/>
            <ComboBox x:Name="TriggerCombo" SelectedIndex="0" SelectionChanged="TriggerCombo_OnSelectionChanged">
                <ComboBoxItem Content="某科目课前打开"/>
                <ComboBoxItem Content="每周固定时间打开"/>
            </ComboBox>

            <TextBlock x:Name="SubjectLabel" Text="科目名称（匹配课表中的科目）" Margin="0 10 0 2"/>
            <TextBox x:Name="SubjectBox" Text="语文"/>

            <TextBlock x:Name="LeadLabel" Text="课前几分钟打开" Margin="0 10 0 2"/>
            <TextBox x:Name="LeadBox" Text="1"/>

            <TextBlock x:Name="TimeLabel" Text="打开时间 HH:mm" Margin="0 10 0 2" Visibility="Collapsed"/>
            <TextBox x:Name="TimeBox" Text="14:00" Visibility="Collapsed"/>

            <TextBlock x:Name="WeekdayLabel" Text="星期" Margin="0 10 0 2" Visibility="Collapsed"/>
            <ComboBox x:Name="WeekdayCombo" SelectedIndex="0" Visibility="Collapsed">
                <ComboBoxItem Content="周日"/>
                <ComboBoxItem Content="周一"/>
                <ComboBoxItem Content="周二"/>
                <ComboBoxItem Content="周三"/>
                <ComboBoxItem Content="周四"/>
                <ComboBoxItem Content="周五"/>
                <ComboBoxItem Content="周六"/>
            </ComboBox>

            <TextBlock Text="要打开的网页" Margin="0 10 0 2"/>
            <TextBox x:Name="UrlBox" Text="https://"/>

            <CheckBox x:Name="EnabledCheck" Content="启用" IsChecked="True" Margin="0 10 0 0"/>

            <StackPanel Orientation="Horizontal" Margin="0 14 0 0">
                <Button Content="添加计划" Padding="14 6" Margin="0 0 8 0" Click="ButtonAdd_OnClick"/>
                <Button Content="更新选中" Padding="14 6" Margin="0 0 8 0" Click="ButtonUpdate_OnClick"/>
                <Button Content="测试触发" Padding="14 6" Click="ButtonTest_OnClick"/>
            </StackPanel>
            <TextBlock Text="「测试触发」会立即弹出与到点时相同的 ClassIsland 横幅提醒 + 确认对话框：点「打开」当场打开网页，点「暂不打开」取消，不写入计划。"
                       FontSize="12" Foreground="#888888" Margin="0 10 0 0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</ci:SettingsPageBase>
