<Window x:Class="ClassIsland.WebOpener.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClassIsland 提醒"
        Height="230" Width="460"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 12">
            <TextBlock Text="⏰" FontSize="20" VerticalAlignment="Center" Margin="0 0 8 0"/>
            <TextBlock x:Name="TitleText" Text="即将打开网页" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
            <TextBlock x:Name="UrlText" TextWrapping="Wrap" FontSize="13" Foreground="#2B54D9" Margin="0 8 0 0"/>
            <TextBlock Text="60 秒内未操作将按计划打开。" FontSize="12" Foreground="#8A8F9C" Margin="0 12 0 0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 18 0 0">
            <Button x:Name="CancelButton" Content="暂不打开" Padding="18 7" Margin="0 0 10 0" Click="ButtonCancel_OnClick"/>
            <Button x:Name="OkButton" Content="打开" Padding="18 7" IsDefault="True" Click="ButtonOk_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
